# ============================================================
#  .env.example  -  MODELO. Copie para .env e preencha:
#      cp .env.example .env
#  O .env de verdade NAO vai pro git nem pros zips (tem segredos).
# ============================================================

# ---- Mailtrap (e-mail de confirmacao do cadastro) ----
# Painel: Email Testing > Inboxes > SMTP Settings > Show Credentials
MAIL_USER=
MAIL_PASSWORD=

# ---- Google Gemini (chatbot com IA) ----
# Pegue em: https://aistudio.google.com/apikey
IA_API_KEY=

# ---- Google reCAPTCHA (secret key do cadastro) ----
# Pegue em: https://www.google.com/recaptcha/admin  (Settings > Secret Key)
RECAPTCHA_SECRET=
